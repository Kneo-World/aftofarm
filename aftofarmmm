-- ==================== ЛОГИКА БЕССМЕРТИЯ (GOD MODE) ====================
RunService.Stepped:Connect(function()
    if not godModeActive then return end
    local char, hum, _ = getCharacter()
    if char and hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                for _, part in ipairs(plr.Character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
    end
end)

-- ==================== ГЛАВНЫЙ ЦИКЛ (ФАРМ, ШЕРИФ, ОРУЖИЕ, УБИЙЦА) ====================
task.spawn(function()
    while true do
        task.wait(0.2)
        
        local char, hum, root = getCharacter()
        if not char or not root or not hum then continue end

        -- 1. ЛОГИКА РВАНКИ ШЕРИФА
        if sheriffFlingActive then
            local sheriff = getSheriffPlayer()
            if sheriff and sheriff.Character and sheriff.Character:FindFirstChild("HumanoidRootPart") then
                local sheriffRoot = sheriff.Character.HumanoidRootPart
                if sheriff ~= LocalPlayer then
                    local oldPos = root.CFrame
                    local startTime = tick()
                    
                    while sheriff and sheriff.Character and sheriff.Character:FindFirstChild("HumanoidRootPart") and (tick() - startTime < 1.5) do
                        root.CFrame = sheriffRoot.CFrame
                        root.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                        sheriffRoot.AssemblyLinearVelocity = Vector3.new(0, -5000, 0)
                        task.wait(0.05)
                    end
                    root.CFrame = oldPos
                end
            end
        end

        -- 2. АВТО-ПОДБОР ПИСТОЛЕТА С ЗЕМЛИ
        if autoGrabGun then
            local gunDrop = Workspace:FindFirstChild("GunDrop", true) or Workspace:FindFirstChild("Gun", true)
            if gunDrop and gunDrop:IsA("BasePart") then
                if firetouchinterest then
                    firetouchinterest(root, gunDrop, 0)
                    task.wait(0.05)
                    firetouchinterest(root, gunDrop, 1)
                else
                    root.CFrame = gunDrop.CFrame
                end
            end
        end

        -- 3. АВТО-ФАРМ МОНЕТ (ПОИСК Coin_Server ВО ВСЕМ ВОРКСПЕЙСЕ)
        if autoFarmActive then
            local coins = {}
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
                    -- Добавим проверку: даже если прозрачность 1, но паретт существует — берем
                    if obj.Parent then
                        table.insert(coins, obj)
                    end
                end
            end

            if #coins > 0 then
                for _, coinPart in ipairs(coins) do
                    if not autoFarmActive then break end
                    if coinPart and coinPart.Parent then
                        root.CFrame = coinPart.CFrame
                        task.wait(0.2) -- Небольшая задержка, чтобы не кикало за телепорт
                    end
                end
            else
                -- Если монет вообще нет, просто стоим на месте (не дергаем в сейф-точку каждую секунду)
                -- root.CFrame = safePointCFrame -- Можешь закомментировать эту строку, чтобы персонаж не улетал
            end
        end

        -- 4. АВТОМАТИЧЕСКИЙ ВЫСТРЕЛ ПО УБИЙЦЕ (5 ВЫСТРЕЛОВ СКВОЗЬ СТЕНЫ)
        if autoShootMurderer then
            local gun = char:FindFirstChild("Gun") or (LocalPlayer:FindFirstChild("Backpack") and LocalPlayer.Backpack:FindFirstChild("Gun"))
            if gun then
                local murderer = getMurdererPlayer()
                if murderer and murderer.Character then
                    local mRoot = murderer.Character:FindFirstChild("HumanoidRootPart") or murderer.Character:FindFirstChild("Head")
                    if mRoot then
                        if gun.Parent ~= char and hum then
                            hum:EquipTool(gun)
                            task.wait(0.1)
                        end
                        
                        for i = 1, 5 do
                            pcall(function()
                                local originPos = root.Position
                                local targetPos = mRoot.Position
                                local originCFrame = CFrame.new(originPos, targetPos)
                                local targetCFrame = CFrame.new(targetPos)
                                
                                local shootEvent = gun:FindFirstChild("Shoot", true) or ReplicatedStorage:FindFirstChild("Shoot", true)
                                if shootEvent then
                                    shootEvent:FireServer(originCFrame, targetCFrame)
                                else
                                    gun:Activate()
                                end
                            end)
                            task.wait(0.05)
                        end
                    end
                end
            end
        end
        
    end
end)

