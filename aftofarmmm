-- ==================== ПОТОК 1: СБОР ИЗ COINCONTAINER ====================
task.spawn(function()
    while true do
        task.wait(0.2)
        
        if not autoFarmActive then
            continue
        end

        local char, hum, root = getCharacter()
        if not char or not root or not hum then
            continue
        end

        -- Считаем монеты внутри контейнера для сброса лимита раунда[cite: 7]
        local totalCoinsOnMap = 0
        local coinContainer = Workspace:FindFirstChild("CoinContainer")
        if coinContainer then
            for _, obj in ipairs(coinContainer:GetChildren()) do
                if obj.Name == "Coin_Server" and obj:IsA("BasePart") then
                    totalCoinsOnMap = totalCoinsOnMap + 1
                end
            end
        end

        if totalCoinsOnMap > 5 and collectedCoinsCount >= maxCoinsPerRound then
            collectedCoinsCount = 0
        end

        -- Если собрали лимит — летим в сейф
        if collectedCoinsCount >= maxCoinsPerRound then
            root.CFrame = safePointCFrame
            task.wait(1)
            continue
        end

        -- Ищем ближайшую монету в контейнере[cite: 7]
        local nearestCoin = findNearestCoin(root.Position)

        if nearestCoin and nearestCoin.Parent then
            local targetPos = nearestCoin.Position
            while autoFarmActive and nearestCoin and nearestCoin.Parent do
                local _, _, _, currentRoot = getCharacter()
                if not currentRoot then break end
                
                local currentPos = currentRoot.Position
                local distance = (currentPos - targetPos).Magnitude
                
                if distance < 3 then
                    root.CFrame = nearestCoin.CFrame
                    break
                end
                
                local moveDir = (targetPos - currentPos).Unit
                currentRoot.CFrame = CFrame.new(currentPos + moveDir * math.min(distance, 40 * 0.05), targetPos)
                currentRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                
                task.wait(0.05)
            end
            
            local _, _, aliveRoot = getCharacter()
            if aliveRoot and autoFarmActive then
                collectedCoinsCount = collectedCoinsCount + 1
                task.wait(0.2)
            end
        else
            task.wait(1)
        end
    end
end)

