-- ==================== ПОТОК 1: БЕСКОНЕЧНЫЙ АВТО-ФАРМ С АВТО-РЕЖИМОМ ПОСЛЕ СМЕРТИ ====================
task.spawn(function()
    while true do
        task.wait(0.5)
        if autoFarmActive then
            local char, hum, root = getCharacter()
            
            -- Если персонаж умер или еще не загрузился, ждем возрождения и не ломаем цикл
            if not char or not root or not hum then
                task.wait(1)
                continue
            end

            -- Если собрали 40 монет за раунд, уходим в сейф и ждем нового раунда
            if collectedCoinsCount >= maxCoinsPerRound then
                root.CFrame = safePointCFrame
                
                local newRoundStarted = false
                while not newRoundStarted do
                    if not autoFarmActive then break end
                    
                    -- Проверяем жив ли еще персонаж во время ожидания
                    local _, _, checkRoot = getCharacter()
                    if not checkRoot then break end
                    
                    task.wait(2)
                    
                    local checkCoinsCount = 0
                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if obj.Name == "Coin_Server" and (obj:IsA("BasePart") or obj:IsA("Part") or obj:IsA("MeshPart")) then
                            if obj.Parent then
                                checkCoinsCount = checkCoinsCount + 1
                            end
                        end
                    end
                    
                    if checkCoinsCount > 5 then
                        collectedCoinsCount = 0
                        newRoundStarted = true
                    end
                end
            else
                -- Ищем ближайшую монету по всему Workspace
                local nearestCoin = nil
                local shortestDistance = math.huge
                
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "Coin_Server" and (obj:IsA("BasePart") or obj:IsA("Part") or obj:IsA("MeshPart")) then
                        if obj.Parent then
                            local dist = (root.Position - obj.Position).Magnitude
                            if dist < shortestDistance then
                                shortestDistance = dist
                                nearestCoin = obj
                            end
                        end
                    end
                end

                if nearestCoin and nearestCoin.Parent then
                    -- Летим к ближайшей монете со скоростью 30
                    smoothFlyTo(nearestCoin.CFrame)
                    
                    -- Проверяем, живы ли после полета
                    local _, _, aliveRoot = getCharacter()
                    if aliveRoot then
                        collectedCoinsCount = collectedCoinsCount + 1
                        
                        -- Пауза 2.5 секунды для безопасности от античита
                        local waitElapsed = 0
                        while waitElapsed < 2.5 do
                            if not autoFarmActive then break end
                            local _, _, rCheck = getCharacter()
                            if not rCheck then break end -- прерываем паузу если умерли
                            waitElapsed = waitElapsed + 0.1
                            task.wait(0.1)
                        end
                    end
                else
                    -- Если монет нет, ждем появления
                    task.wait(1)
                end
            end
        end
    end
end)

-- ==================== ПОТОК 2: БОЕВАЯ СИСТЕМА ====================
